# ThinkTech Q&A Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit real credentials, service-role keys, or passwords to git.

# Application URL (used for QR code generation on /display)
NEXT_PUBLIC_APP_URL=https://thinktech-qna.vercel.app

# Supabase Project Credentials
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
